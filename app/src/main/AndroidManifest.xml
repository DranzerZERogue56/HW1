<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Audio control -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- DND / interruption filter -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Foreground service (all APIs) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Foreground service type 'specialUse' (API 34+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Battery optimisation request -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_unmuted"
        android:roundIcon="@drawable/ic_unmuted"
        android:supportsRtl="true"
        android:theme="@style/Theme.GlobalMute">

        <!-- ── Main activity ── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── Foreground service: audio + DND muting ── -->
        <service
            android:name=".service.GlobalMuteService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Silences device ring, notification, system, media, and alarm volumes and enables Total Silence DND while the user-requested mute is active." />
        </service>

        <!-- ── Notification listener: cancel notifications + pause media ── -->
        <service
            android:name=".service.MuteNotificationListener"
            android:exported="true"
            android:label="GlobalMute Notification Listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- ── Quick Settings tile ── -->
        <service
            android:name=".tile.MuteTileService"
            android:exported="true"
            android:icon="@drawable/ic_unmuted"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- ── Home screen widget ── -->
        <receiver
            android:name=".widget.MuteWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mute_widget_info" />
        </receiver>

    </application>
</manifest>
